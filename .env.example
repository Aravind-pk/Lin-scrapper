# Copy to .env and fill in. Never commit .env.

# The whole LinkedIn Cookie header, on one line.
#   DevTools -> Network -> any linkedin.com request -> Copy as cURL,
#   then take everything after `Cookie: `.
#
# Paste all of it rather than picking out individual cookies.
#
# Optional: callers may send their own cookie_header per request instead, in
# which case the server needs no session of its own. Callers that do should
# also send user_agent, so the request matches the browser the cookies came
# from — the playground does this automatically.
LI_COOKIE_HEADER=

# Optional.
REQUEST_TIMEOUT=15.0
LOG_LEVEL=INFO
