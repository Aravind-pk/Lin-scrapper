# Copy to .env and fill in. Never commit .env.

# The whole LinkedIn Cookie header, on one line.
#   DevTools -> Network -> any linkedin.com request -> Copy as cURL,
#   then take everything after `Cookie: `.

LI_COOKIE_HEADER=

# API key clients must send as X-API-Key.
API_KEY=

# Optional.
REQUEST_TIMEOUT=15.0
LOG_LEVEL=INFO
